{
  "name": "dsh-trigger-prompts",
  "version": "0.4.0",
  "description": "DSH 插件：把各已装插件的工具整理成中文清单——插件 3 行简介 + 每个工具一句话用途，可搜索、可置顶、可长按拖拽，入口在「对话 / 轨迹 / 画廊」右侧。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompts",
    "tools",
    "debug"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/smoke.mjs"
  },
  "license": "MIT"
}
